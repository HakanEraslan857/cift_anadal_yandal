@model IEnumerable<cift_anadal_yandal.Models.Mesajlar>

@{
    ViewData["Title"] = "Öğrenci Sohbet";
    var ogrenci = ViewBag.Ogrenci as cift_anadal_yandal.Models.Ogrenciler;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">@ogrenci?.OgrenciNo - @ogrenci?.Ad @ogrenci?.Soyad ile Mesajlaşma</h4>
                <a asp-action="Panel" class="btn btn-secondary btn-sm">Listeye Dön</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span>Anadal: @ogrenci?.AnaBolum?.BolumAdi | Tür: @ogrenci?.BasvuruTuru</span>
                    <span class="badge bg-warning text-dark">Kalıcı Mesaj Kaydı</span>
                </div>
                <div class="card-body" style="max-height: 450px; overflow-y: auto; background-color: #f8f9fa;">
                    @if (!Model.Any())
                    {
                        <div class="text-center text-muted py-4">
                            Bu öğrenci ile henüz mesaj geçmişi bulunmamaktadır.
                        </div>
                    }
                    else
                    {
                        @foreach (var m in Model)
                        {
                            bool koordinatorMu = m.GonderenRol == "Koordinator";
                            <div class="d-flex mb-3 @(koordinatorMu ? "justify-content-end" : "justify-content-start")">
                                <div class="p-3 rounded-3 shadow-sm @(koordinatorMu ? "bg-success text-white" : "bg-white border text-dark")" style="max-width: 75%;">
                                    <div class="small fw-bold mb-1 @(koordinatorMu ? "text-light" : "text-primary")">
                                        @m.GonderenAd
                                    </div>
                                    <div class="mb-2" style="white-space: pre-wrap;">@m.MesajMetni</div>
                                    <div class="text-end" style="font-size: 0.75rem; opacity: 0.85;">
                                        @m.GonderimTarihi.ToString("dd.MM.yyyy HH:mm:ss")
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="card-footer bg-white">
                    <form asp-action="KoordinatorMesajGonder" method="post">
                        <input type="hidden" name="ogrenciId" value="@ogrenci?.OgrenciId" />
                        <div class="input-group">
                            <textarea name="mesajMetni" class="form-control" rows="2" placeholder="Öğrenciye mesajınızı yazın..." required></textarea>
                            <button type="submit" class="btn btn-success px-4 fw-bold">Gönder</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>