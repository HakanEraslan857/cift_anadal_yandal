<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - cift_anadal_yandal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/cift_anadal_yandal.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="[https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css](https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css)">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">cift_anadal_yandal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                            </li>
                        }


                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Öğrenciyse Sadece Başvuru Yap Linkini Görür -->
                            @if (User.IsInRole("Ogrenci"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Basvurular" asp-action="Create">ÇAP/Yandal Başvurusu Yap</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Basvurular" asp-action="Index">Başvurularım</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-controller="DersSecimi" asp-action="Index">Ders Seçimi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-success fw-bold" asp-controller="Mesajlar" asp-action="Index">Mesajlar</a>
                                </li>
                            }

                            <!-- Koordinatör veya Başkan ise Başvuru Listesini Görür -->
                            @if (User.IsInRole("Koordinator") || User.IsInRole("BolumBaskani"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Basvurular" asp-action="Index">Başvuru Listesi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-controller="DersSecimi" asp-action="OnayListesi">Ders Seçim Onayları</a>
                                </li>
                            }

                            <!-- Sadece Koordinatör Bölüm Yönetimini Görür -->
                            @if (User.IsInRole("Koordinator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Ogrenciler" asp-action="Index">Öğrenci Yönetimi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-success fw-bold" asp-controller="Mesajlar" asp-action="Panel">Mesajlar</a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Sağ Tarafa Kullanıcı Adı ve Çıkış/Giriş Butonları Ekliyoruz -->
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-primary font-weight-bold">
                                    Hoşgeldin, @User.Identity.Name
                                    (@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value)
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Kullanicilar" asp-action="Logout">Çıkış Yap</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - cift_anadal_yandal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
